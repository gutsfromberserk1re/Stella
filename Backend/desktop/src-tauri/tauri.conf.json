{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pluto",
  "version": "0.1.0",
  "identifier": "com.pluto.videoeditor",
  "build": {
    "frontendDist": "../../../Frontdoor"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pluto",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": {
      "ffmpeg/ffmpeg.exe": "ffmpeg/ffmpeg.exe",
      "ffmpeg/ffprobe.exe": "ffmpeg/ffprobe.exe"
    }
  }
}
